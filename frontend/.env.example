# URL base da API do backend (sem barra final)
VITE_API_URL=http://localhost:3000/api/v1

# Quando "true", o cliente HTTP usa respostas simuladas (src/services/mock/)
# em vez de chamar o backend. Util enquanto o backend nao tem banco no ar.
VITE_API_MOCK=false

# Client ID OAuth do Google (mesmo valor do backend). Vazio desabilita o botao.
VITE_GOOGLE_CLIENT_ID=
