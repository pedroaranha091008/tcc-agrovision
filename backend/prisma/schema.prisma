generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TipoUsuario {
  produtor
  agronomo
  empresa
}

enum StatusOrcamento {
  novo
  em_contato
  concluido
  cancelado
}

enum StatusTalhao {
  ativo
  inativo
  em_analise
}

enum TipoAnalise {
  NDVI
  RGB
  termico
  multispectral
  outro
}

enum OrigemAnalise {
  automatica
  manual
}

enum NivelRisco {
  baixo
  medio
  alto
  critico
}

model Usuario {
  id_usuario    String      @id @default(uuid()) @db.Char(36)
  nome          String      @db.VarChar(150)
  email         String      @unique @db.VarChar(255)
  senha_hash    String      @db.VarChar(255)
  telefone      String?     @db.VarChar(20)
  tipo_usuario  TipoUsuario @default(produtor)
  data_criacao  DateTime    @default(now())
  atualizado_em DateTime    @updatedAt

  propriedades Propriedade[]
  sessoes      Sessao[]
  redefinicoes RedefinicaoSenha[]

  @@map("usuarios")
}

model Propriedade {
  id_propriedade      String   @id @default(uuid()) @db.Char(36)
  id_usuario          String   @db.Char(36)
  nome_fazenda        String   @db.VarChar(200)
  estado              String   @db.Char(2)
  cidade              String   @db.VarChar(150)
  area_total_hectares Decimal? @db.Decimal(10, 2)
  criado_em           DateTime @default(now())
  atualizado_em       DateTime @updatedAt

  usuario Usuario  @relation(fields: [id_usuario], references: [id_usuario])
  talhoes Talhao[]

  @@index([id_usuario])
  @@map("propriedades")
}

model Talhao {
  id_talhao      String       @id @default(uuid()) @db.Char(36)
  id_propriedade String       @db.Char(36)
  nome_talhao    String       @db.VarChar(150)
  cultura        String?      @db.VarChar(100)
  area_hectares  Decimal?     @db.Decimal(10, 2)
  latitude       Decimal?     @db.Decimal(10, 7)
  longitude      Decimal?     @db.Decimal(10, 7)
  geojson        Json?
  status         StatusTalhao @default(ativo)
  criado_em      DateTime     @default(now())
  atualizado_em  DateTime     @updatedAt

  propriedade Propriedade @relation(fields: [id_propriedade], references: [id_propriedade])
  voos        Voo[]

  @@index([id_propriedade])
  @@map("talhoes")
}

model Voo {
  id_voo          String   @id @default(uuid()) @db.Char(36)
  id_talhao       String   @db.Char(36)
  data_voo        DateTime
  altitude_metros Decimal? @db.Decimal(6, 1)
  modelo_drone    String?  @db.VarChar(100)
  operador        String?  @db.VarChar(150)
  observacoes     String?  @db.Text
  criado_em       DateTime @default(now())

  talhao   Talhao      @relation(fields: [id_talhao], references: [id_talhao])
  analises Analise[]
  imagens  ImagemVoo[]

  @@index([id_talhao])
  @@index([data_voo])
  @@map("voos")
}

model Analise {
  id_analise              String        @id @default(uuid()) @db.Char(36)
  id_voo                  String        @db.Char(36)
  tipo_analise            TipoAnalise
  nivel_risco             NivelRisco?
  percentual_area_afetada Decimal?      @db.Decimal(5, 2)
  resultado               String?       @db.Text
  url_arquivo             String?       @db.VarChar(500)
  origem                  OrigemAnalise @default(manual)
  detalhes                Json?
  data_analise            DateTime      @default(now())
  atualizado_em           DateTime      @updatedAt

  voo Voo @relation(fields: [id_voo], references: [id_voo])

  @@index([id_voo])
  @@index([tipo_analise])
  @@index([nivel_risco])
  @@map("analises")
}

// Pedidos feitos pelo formulário "Solicite seu orçamento" da página inicial (não exigem conta).
model SolicitacaoOrcamento {
  id_solicitacao String          @id @default(uuid()) @db.Char(36)
  nome           String          @db.VarChar(150)
  email          String          @db.VarChar(255)
  telefone       String          @db.VarChar(20)
  cidade         String          @db.VarChar(150)
  cultura        String          @db.VarChar(100)
  area_hectares  Decimal         @db.Decimal(12, 2)
  servico        String          @db.VarChar(100)
  mensagem       String?         @db.Text
  status         StatusOrcamento @default(novo)
  criado_em      DateTime        @default(now())
  atualizado_em  DateTime        @updatedAt

  @@index([status])
  @@index([criado_em])
  @@map("solicitacoes_orcamento")
}

// Imagens captadas pelo drone e enviadas para um voo. O arquivo fica em UPLOAD_DIR, fora do código.
model ImagemVoo {
  id_imagem     String   @id @default(uuid()) @db.Char(36)
  id_voo        String   @db.Char(36)
  nome_original String   @db.VarChar(255)
  nome_arquivo  String   @db.VarChar(255)
  mime_type     String   @db.VarChar(100)
  tamanho_bytes Int
  largura       Int?
  altura        Int?
  criado_em     DateTime @default(now())

  voo Voo @relation(fields: [id_voo], references: [id_voo])

  @@index([id_voo])
  @@map("imagens_voo")
}

// Sessões de login. Guarda só o hash do token de renovação (o token em si fica num cookie httpOnly).
model Sessao {
  id_sessao       String    @id @default(uuid()) @db.Char(36)
  id_usuario      String    @db.Char(36)
  token_hash      String    @unique @db.Char(64)
  lembrar         Boolean   @default(false)
  expira_em       DateTime
  revogada_em     DateTime?
  substituida_por String?   @db.Char(36)
  user_agent      String?   @db.VarChar(255)
  criado_em       DateTime  @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_usuario])
  @@map("sessoes")
}

// Pedidos de "esqueci a senha": token de uso único (só o hash é guardado), válido por pouco tempo.
model RedefinicaoSenha {
  id_redefinicao String    @id @default(uuid()) @db.Char(36)
  id_usuario     String    @db.Char(36)
  token_hash     String    @unique @db.Char(64)
  expira_em      DateTime
  usada_em       DateTime?
  criado_em      DateTime  @default(now())

  usuario Usuario @relation(fields: [id_usuario], references: [id_usuario])

  @@index([id_usuario])
  @@map("redefinicoes_senha")
}
