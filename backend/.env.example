
DATABASE_URL="mysql://usuario:senha@host/nome_banco"

DATABASE_USER="usuario"
DATABASE_PASSWORD="senha"
DATABASE_NAME="nome_banco"
DATABASE_HOST="host"
DATABASE_PORT=3306

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Autenticação — gere um valor longo e aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# Duração do token de acesso (minutos) e da sessão "manter conectado" (dias)
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30

# Uploads de imagens dos voos (pasta fora do código; criada automaticamente)
UPLOAD_DIR="uploads"
UPLOAD_MAX_MB=25
UPLOAD_MAX_ARQUIVOS=20

# Tentativas de login/cadastro por IP a cada 15 min (padrão 20). Aumente só para rodar os testes E2E.
# LIMITE_TENTATIVAS_AUTH=20

# Site (usado nos links dos emails). Padrão: primeira origem do CORS_ORIGIN.
# FRONTEND_URL="http://localhost:5173"

# Envio de email (recuperação de senha). Sem SMTP_HOST, em desenvolvimento o email
# aparece no terminal e é salvo em backend/emails-enviados/.
# SMTP_HOST="smtp.exemplo.com"
# SMTP_PORT=587
# SMTP_USER="usuario"
# SMTP_PASS="senha"
# SMTP_FROM="AgroVision <nao-responda@agrovision.com.br>"
