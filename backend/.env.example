# === Servidor ===
PORT=3000
NODE_ENV=development

# Origens permitidas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:5173

# === Banco de dados (MySQL/MariaDB) ===
DATABASE_URL="mysql://usuario:senha@host:3306/nome_banco"
DATABASE_USER="usuario"
DATABASE_PASSWORD="senha"
DATABASE_NAME="nome_banco"
DATABASE_HOST="host"
DATABASE_PORT=3306

# === Autenticacao ===
# Segredo do access token JWT
JWT_ACCESS_SECRET="troque-por-um-valor-aleatorio-longo"
# Duracao do access token (formato do jsonwebtoken: 15m, 1h, etc.)
JWT_ACCESS_TTL=15m
# Segredo usado para derivar o hash do refresh token
REFRESH_SECRET="troque-por-outro-valor-aleatorio-longo"
# Duracao do refresh token em dias
REFRESH_TTL_DAYS=30

# === Login Google ===
GOOGLE_CLIENT_ID=""

# === Upload de imagens ===
UPLOAD_DIR="./uploads"
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_FILES=20
UPLOAD_ALLOWED_MIME="image/jpeg,image/png,image/tiff"

# === Relatorios ===
REPORT_DIR="./relatorios"
